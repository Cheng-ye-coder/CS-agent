<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.bitselect</groupId>
        <artifactId>CS-agent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>bootstrap</artifactId>
    <name>bootstrap</name>
    <description>启动模块：Application 入口</description>

    <dependencies>
        <dependency>
            <groupId>com.bitselect</groupId>
            <artifactId>framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bitselect</groupId>
            <artifactId>infra-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bitselect</groupId>
            <artifactId>system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bitselect</groupId>
            <artifactId>rag</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bitselect</groupId>
            <artifactId>agent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bitselect</groupId>
            <artifactId>mcp-server</artifactId>
        </dependency>

        <!-- Web 与 SSE -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Jackson 2 兼容层：Spring Boot 4 默认 Jackson 3，AgentScope 与 MCP 需要 Jackson 2 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>

        <!-- DevTools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <finalName>CS-agent</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.bitselect.agent.BootstrapApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>